---
import styles from './Timeline.module.css';
import { formatMonthDay, isoDate } from '../../../shared/lib/dates';
import { postPath, type Post } from '../data/posts';

interface Props {
  /** Newest first. */
  posts: Post[];
}

const { posts } = Astro.props;

const years = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), post]);
}
---

<div class={styles.timeline}>
  {
    [...years].map(([year, yearPosts]) => (
      <section class={styles.year} aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class={styles.yearLabel}>{year}</h2>
        <ol class={styles.posts}>
          {yearPosts.map((post) => (
            <li class={styles.post}>
              <p class={styles.date}>
                <time datetime={isoDate(post.data.pubDate)}>{formatMonthDay(post.data.pubDate)}</time>
              </p>
              <h3 class={styles.title}>
                <a href={postPath(post)}>{post.data.title}</a>
              </h3>
              <p class={styles.description}>{post.data.description}</p>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>
