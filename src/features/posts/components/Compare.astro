---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import styles from './Compare.module.css';

interface Props {
  before: ImageMetadata;
  beforeAlt: string;
  after: ImageMetadata;
  afterAlt: string;
}

const { before, beforeAlt, after, afterAlt } = Astro.props;
---

<div class={styles.compare}>
  <figure class={styles.side}>
    <Image src={before} alt={beforeAlt} />
    <figcaption class={styles.caption}>before</figcaption>
  </figure>
  <figure class={styles.side}>
    <Image src={after} alt={afterAlt} />
    <figcaption class={styles.caption}>after</figcaption>
  </figure>
</div>
