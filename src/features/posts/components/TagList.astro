---
import styles from './TagList.module.css';
import { tagPath } from '../data/posts';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class={styles.tags} aria-label="Tags">
      {tags.map((tag) => (
        <li>
          <a class={styles.tag} href={tagPath(tag)}>#{tag}</a>
        </li>
      ))}
    </ul>
  )
}
