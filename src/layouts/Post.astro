---
import Base from './Base.astro';
import styles from './Post.module.css';
import PageHeader from '../components/PageHeader.astro';
import PostMeta from '../features/posts/components/PostMeta.astro';
import TagList from '../features/posts/components/TagList.astro';
import Prose from '../features/posts/components/Prose.astro';
import type { Post } from '../features/posts/data/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
---

<Base title={title} description={description} image={heroImage} article={{ pubDate, updatedDate, tags }}>
  <article>
    <PageHeader title={title} description={description}>
      <PostMeta slot="meta" pubDate={pubDate} updatedDate={updatedDate} />
      <TagList tags={tags} />
    </PageHeader>
    <Prose>
      <slot />
    </Prose>
  </article>
  <p class={styles.back}><a href="/">← All posts</a></p>
</Base>
