---
import Base from './Base.astro';
import styles from './Page.module.css';
import Prose from '../features/posts/components/Prose.astro';

// Layout for Markdown pages in src/pages (set with `layout:` in their frontmatter).
interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}

const { title, description } = Astro.props.frontmatter;
---

<Base title={title} description={description}>
  <article>
    <header class={styles.header}>
      <h1 class={styles.title}>{title}</h1>
      <p class={styles.lede}>{description}</p>
    </header>
    <Prose>
      <slot />
    </Prose>
  </article>
</Base>
