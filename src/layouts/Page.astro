---
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../features/posts/components/Prose.astro';

// Layout for Markdown pages in src/pages (set with `layout:` in their frontmatter).
interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}

const { title, description } = Astro.props.frontmatter;
---

<Base title={title} description={description}>
  <article>
    <PageHeader title={title} description={description} />
    <Prose>
      <slot />
    </Prose>
  </article>
</Base>
